# Copy this file to .env and replace the placeholders before starting the API.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_with_your_mysql_password
DB_NAME=hostel_management

# Set a unique random value. Do not use the placeholder as a real secret.
JWT_SECRET=replace_with_a_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
